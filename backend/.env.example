# Database - REQUIRED
# For production use Supabase connection string
DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:6543/postgres

# JWT - REQUIRED - generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Company Info - REQUIRED
COMPANY_NAME=Your Company Name
COMPANY_ADDRESS=Your Company Address
COMPANY_GSTIN=YOUR_GSTIN_HERE
COMPANY_PHONE=+91-XXXXXXXXXX
COMPANY_EMAIL=info@yourcompany.com

# Admin User (used by seed.py only)
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# SMTP Email - OPTIONAL (for password reset emails)
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Your Company Name

# Frontend URL (for reset email links)
FRONTEND_URL=https://your-app.vercel.app
